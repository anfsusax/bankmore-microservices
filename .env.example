# Copie para ".env" (ignorado pelo git) e troque os valores.
#   cp .env.example .env
# Segredo nunca vai para o repositório: nem appsettings.json, nem docker-compose.yml.

POSTGRES_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres (HMAC-SHA256). Gere com: openssl rand -base64 48
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
