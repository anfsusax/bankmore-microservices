@inherits LayoutComponentBase
@inject UserSessionService Session
@implements IDisposable

<div class="app-container">
    <aside class="sidebar">
        <div class="brand mb-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-building-columns brand-icon"></i>
            <span>Bank<span style="color: var(--primary-blue);">More</span></span>
        </div>

        <nav class="d-flex flex-column gap-2">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="fa-solid fa-chart-pie" style="color: var(--primary-blue);"></i> Dashboard
            </NavLink>

            <NavLink class="nav-link" href="movimentacoes">
                <i class="fa-solid fa-money-bill-transfer" style="color: var(--accent-green-dark);"></i> Movimentações
            </NavLink>

            <NavLink class="nav-link" href="login">
                <i class="fa-solid fa-user-lock" style="color: var(--primary-accent);"></i> Conta / Login
            </NavLink>
        </nav>

        <div class="mt-auto pt-4 border-top" style="border-color: var(--border-card) !important;">
            @if (Session.IsAuthenticated)
            {
                <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background-color: var(--bg-main);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; background-color: var(--primary-light); color: var(--primary-blue); font-size: 0.9rem;">
                            @(string.IsNullOrEmpty(Session.Nome) ? "U" : Session.Nome.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="fw-bold text-truncate" style="max-width: 120px; font-size: 0.9rem; color: var(--text-main);">@Session.Nome</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Conta: @Session.NumeroConta</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-light border-0 text-danger" @onclick="Session.EncerrarSessao" title="Sair da Conta">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            }
            else
            {
                <div class="text-center py-2 px-3 rounded-3" style="background-color: var(--bg-main);">
                    <small class="text-muted"><i class="fa-solid fa-user-circle me-1"></i> Modo Visitante</small>
                </div>
            }
        </div>
    </aside>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnStateChanged -= StateHasChanged;
    }
}

