@page "/login"
@rendermode InteractiveServer
@inject UserSessionService Session
@inject BankMoreApiClient ApiClient
@inject NavigationManager Navigation

<div class="row justify-content-center py-4">
    <div class="col-lg-5 col-md-8">
        <div class="glass-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand mb-2" style="font-size: 2rem; font-weight: 800;">
                    <i class="fa-solid fa-building-columns brand-icon"></i>
                    <span>Bank<span style="color: var(--primary-blue);">More</span></span>
                </div>
                <p class="text-muted">Acesse sua conta digital ou cadastre-se em segundos</p>
            </div>

            <!-- TABS DE NAVEGAÇÃO -->
            <div class="d-flex mb-4 p-1 rounded-3" style="background-color: var(--bg-body); border: 1px solid var(--border-card);">
                <button class="btn w-50 py-2 fw-semibold @(abaAtiva == "login" ? "btn-primary-bank" : "btn-secondary-bank border-0 bg-transparent text-muted")" @onclick='() => AlternarAba("login")'>
                    <i class="fa-solid fa-lock me-1"></i> Entrar
                </button>
                <button class="btn w-50 py-2 fw-semibold @(abaAtiva == "cadastro" ? "btn-primary-bank" : "btn-secondary-bank border-0 bg-transparent text-muted")" @onclick='() => AlternarAba("cadastro")'>
                    <i class="fa-solid fa-user-plus me-1"></i> Criar Conta
                </button>
            </div>

            <!-- MENSAGEM ALERTA -->
            @if (!string.IsNullOrEmpty(mensagemAlert))
            {
                <div class="alert @(sucessoAlert ? "alert-bank-success" : "alert-bank-danger") mb-4 p-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid @(sucessoAlert ? "fa-circle-check" : "fa-triangle-exclamation") fs-5 me-2"></i>
                    <span class="fw-medium">@mensagemAlert</span>
                </div>
            }

            @if (abaAtiva == "login")
            {
                <!-- FORMULÁRIO DE LOGIN -->
                <EditForm Model="loginModel" OnValidSubmit="ExecutarLogin">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">CPF ou Número da Conta</label>
                        <InputText @bind-Value="loginModel.DocumentoOuConta" class="form-input" placeholder="Ex: 12345678909 ou 5001" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">Senha de Acesso</label>
                        <InputText @bind-Value="loginModel.Senha" type="password" class="form-input" placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn-primary-bank w-100 justify-content-center py-3" disabled="@processando">
                        @if (processando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Autenticando...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>
                            <span>Entrar na Minha Conta</span>
                        }
                    </button>
                </EditForm>
            }
            else
            {
                <!-- FORMULÁRIO DE CADASTRO -->
                <EditForm Model="registerModel" OnValidSubmit="ExecutarCadastro">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Nome Completo</label>
                        <InputText @bind-Value="registerModel.Nome" class="form-input" placeholder="Ex: Carlos Eduardo" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">CPF (apenas números)</label>
                            <InputText @bind-Value="registerModel.Cpf" class="form-input" placeholder="Ex: 12345678909" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Número da Conta</label>
                            <InputNumber @bind-Value="registerModel.NumeroConta" class="form-input" placeholder="Ex: 5001" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">E-mail</label>
                        <InputText @bind-Value="registerModel.Email" type="email" class="form-input" placeholder="seu@email.com" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">Senha de Acesso</label>
                        <InputText @bind-Value="registerModel.Senha" type="password" class="form-input" placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn-primary-bank w-100 justify-content-center py-3" disabled="@processando">
                        @if (processando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Criando Conta...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-user-check me-1"></i>
                            <span>Cadastrar e Abrir Conta</span>
                        }
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private string abaAtiva = "login";
    private bool processando = false;
    private string mensagemAlert = "";
    private bool sucessoAlert = false;

    private LoginModel loginModel = new();
    private RegisterModel registerModel = new();

    private void AlternarAba(string aba)
    {
        abaAtiva = aba;
        mensagemAlert = "";
    }

    private async Task ExecutarLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.DocumentoOuConta) || string.IsNullOrWhiteSpace(loginModel.Senha))
        {
            sucessoAlert = false;
            mensagemAlert = "Preencha o CPF/Conta e a senha.";
            return;
        }

        processando = true;
        mensagemAlert = "";

        var result = await ApiClient.LoginAsync(loginModel);
        processando = false;

        if (result.Sucesso && result.Dados != null)
        {
            var token = result.Dados.Token;
            var nome = !string.IsNullOrWhiteSpace(result.Dados.Usuario?.Nome) 
                ? result.Dados.Usuario.Nome 
                : (!string.IsNullOrWhiteSpace(result.Dados.Conta?.Nome) ? result.Dados.Conta.Nome : "Usuário BankMore");
            var cpf = !string.IsNullOrWhiteSpace(result.Dados.Usuario?.Cpf) 
                ? result.Dados.Usuario.Cpf 
                : loginModel.DocumentoOuConta;
            var numConta = result.Dados.Conta?.Numero ?? 0;
            var contaId = result.Dados.Conta?.Id ?? Guid.Empty;
            var saldo = result.Dados.Conta?.Saldo ?? 0m;

            // Se o login foi feito por número de conta direto e não veio conta no objeto
            if (numConta == 0 && int.TryParse(loginModel.DocumentoOuConta, out int parsedNum))
            {
                numConta = parsedNum;
            }

            if (saldo == 0m && numConta > 0)
            {
                saldo = await ApiClient.ObterSaldoPorNumeroAsync(numConta);
            }

            Session.DefinirSessao(token, nome, cpf, numConta, contaId, saldo);

            sucessoAlert = true;
            mensagemAlert = $"Bem-vindo, {nome}! Autenticado com sucesso. Redirecionando...";
            await Task.Delay(600);
            Navigation.NavigateTo("/");
        }
        else
        {
            sucessoAlert = false;
            mensagemAlert = result.Mensagem;
        }
    }

    private async Task ExecutarCadastro()
    {
        if (string.IsNullOrWhiteSpace(registerModel.Nome) || string.IsNullOrWhiteSpace(registerModel.Cpf) || string.IsNullOrWhiteSpace(registerModel.Senha))
        {
            sucessoAlert = false;
            mensagemAlert = "Preencha todos os campos obrigatórios.";
            return;
        }

        processando = true;
        mensagemAlert = "";

        // 1. Cadastra Usuário
        var regResult = await ApiClient.RegistrarUsuarioAsync(registerModel);

        if (!regResult.Sucesso)
        {
            processando = false;
            sucessoAlert = false;
            mensagemAlert = regResult.Mensagem;
            return;
        }

        // 2. Cria Conta Corrente
        var contaResult = await ApiClient.CriarContaCorrenteAsync(new CriarContaModel
        {
            Nome = registerModel.Nome,
            Numero = registerModel.NumeroConta,
            Senha = registerModel.Senha
        });

        processando = false;

        if (contaResult.Sucesso)
        {
            // 3. Fazer Login automático
            var loginRes = await ApiClient.LoginAsync(new LoginModel
            {
                DocumentoOuConta = registerModel.Cpf,
                Senha = registerModel.Senha
            });

            var token = loginRes.Sucesso && loginRes.Dados != null ? loginRes.Dados.Token : "";

            Session.DefinirSessao(token, registerModel.Nome, registerModel.Cpf, registerModel.NumeroConta, contaResult.Dados, 0m);

            sucessoAlert = true;
            mensagemAlert = "Conta cadastrada com sucesso! Redirecionando para o Dashboard...";
            await Task.Delay(800);
            Navigation.NavigateTo("/");
        }
        else
        {
            sucessoAlert = false;
            mensagemAlert = contaResult.Mensagem;
        }
    }
}

