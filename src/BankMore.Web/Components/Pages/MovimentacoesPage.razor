@page "/movimentacoes"
@rendermode InteractiveServer
@inject UserSessionService Session
@inject BankMoreApiClient ApiClient
@implements IDisposable

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0" style="font-size: 1.8rem; color: var(--text-main);">
                <i class="fa-solid fa-money-bill-transfer text-success me-2"></i> Movimentações Financeiras
            </h2>
            <p class="text-muted m-0">Realize depósitos e saques na sua conta BankMore com segurança e liquidação imediata</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAlert))
    {
        <div class="alert @(sucessoAlert ? "alert-bank-success" : "alert-bank-danger") alert-dismissible fade show p-3 mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid @(sucessoAlert ? "fa-circle-check" : "fa-triangle-exclamation") fs-5 me-2"></i>
                <span class="fw-medium">@mensagemAlert</span>
            </div>
            <button type="button" class="btn-close" @onclick='() => mensagemAlert = ""'></button>
        </div>
    }

    <div class="row g-4">
        <!-- FORMULÁRIO DE OPERAÇÃO -->
        <div class="col-lg-6">
            <div class="glass-card p-4 h-100">
                <h5 class="fw-bold mb-3" style="color: var(--text-main);">
                    <i class="fa-solid fa-cash-register me-2" style="color: var(--primary-blue);"></i> Nova Operação
                </h5>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Tipo de Operação</label>
                    <select class="form-input" @bind="tipoOperacao">
                        <option value="C">📥 Depósito (Crédito +)</option>
                        <option value="D">📤 Saque (Débito -)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Número da Conta Destino</label>
                    <input type="number" class="form-input" @bind="numeroContaTarget" placeholder="Ex: 5001" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Valor da Operação (R$)</label>
                    <input type="number" step="0.01" class="form-input" @bind="valorOperacao" placeholder="100.00" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Descrição ou Observação (Opcional)</label>
                    <input type="text" class="form-input" @bind="descricaoOperacao" placeholder="Ex: Depósito de salário" />
                </div>

                <button class="btn-primary-bank w-100 justify-content-center py-3" @onclick="ExecutarOperacao" disabled="@processando">
                    @if (processando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Processando Operação...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        <span>Confirmar e Processar</span>
                    }
                </button>
            </div>
        </div>

        <!-- RESUMO DA CONTA & REGRAS DE NEGÓCIO -->
        <div class="col-lg-6">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3" style="color: var(--text-main);">
                        <i class="fa-solid fa-shield-halved me-2" style="color: var(--primary-accent);"></i> Regras de Idempotência & Segurança
                    </h5>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-3 mb-4">
                        <li class="d-flex align-items-start gap-2">
                            <i class="fa-solid fa-circle-check text-success mt-1"></i>
                            <div><strong>Créditos (C)</strong>: Adicionam saldo à conta corrente especificada imediatamente.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="fa-solid fa-circle-check text-success mt-1"></i>
                            <div><strong>Débitos (D)</strong>: Subtraem saldo e exigem token ativo ou autorização da conta.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <i class="fa-solid fa-circle-check text-success mt-1"></i>
                            <div><strong>Idempotência</strong>: Cada operação gera um UUID único prevenindo cobranças duplicadas em caso de retransmissão de rede.</div>
                        </li>
                    </ul>
                </div>

                <div class="p-4 rounded-3" style="background-color: var(--primary-light); border: 1px solid #bfdbfe;">
                    <small class="text-muted d-block mb-1 fw-semibold text-uppercase font-monospace" style="font-size: 0.75rem;">Saldo Atual Registrado</small>
                    <h3 class="fw-bold text-success m-0" style="font-size: 2rem;">@Session.Saldo.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string tipoOperacao = "C";
    private int numeroContaTarget = 5001;
    private decimal valorOperacao = 100m;
    private string descricaoOperacao = "";
    private bool processando = false;
    private string mensagemAlert = "";
    private bool sucessoAlert = false;

    protected override void OnInitialized()
    {
        Session.OnStateChanged += StateHasChanged;
        numeroContaTarget = Session.NumeroConta;
    }

    private async Task ExecutarOperacao()
    {
        if (valorOperacao <= 0)
        {
            sucessoAlert = false;
            mensagemAlert = "O valor deve ser maior que R$ 0,00.";
            return;
        }

        processando = true;
        mensagemAlert = "";

        var model = new MovimentoModel
        {
            Tipo = tipoOperacao,
            Valor = valorOperacao,
            NumeroConta = numeroContaTarget,
            Descricao = string.IsNullOrWhiteSpace(descricaoOperacao) ? (tipoOperacao == "C" ? "Depósito via Blazor" : "Saque via Blazor") : descricaoOperacao,
            ChaveIdempotencia = Guid.NewGuid().ToString()
        };

        var result = await ApiClient.MovimentarContaAsync(model, Session.Token);

        processando = false;
        sucessoAlert = result.Sucesso;
        mensagemAlert = result.Mensagem;

        if (result.Sucesso)
        {
            Session.AdicionarMovimento(model.Tipo, model.Valor, model.Descricao, model.ChaveIdempotencia);

            if (Session.ContaId != Guid.Empty)
            {
                var novoSaldo = await ApiClient.ObterSaldoAsync(Session.ContaId);
                Session.AtualizarSaldo(novoSaldo);
            }
        }
    }

    public void Dispose()
    {
        Session.OnStateChanged -= StateHasChanged;
    }
}

