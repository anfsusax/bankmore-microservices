<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Microsoft.Data.SqlClient vem transitivamente do provider EF SqlServer (evita conflito de versão). -->
	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.66" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<!-- Pin de segurança: o SqlClient puxa Pkcs 9.0.11 (GHSA-846f-f764-76mx, severidade alta). -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BankMore.Auth.Domain\BankMore.Auth.Domain.csproj" />
	</ItemGroup>

</Project>
